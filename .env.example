# Required for model requests. The key can also be entered in Settings > Models.
DEEPSEEK_API_KEY=

# The image pins (DSH_VERSION, DSH_FORK_COMMIT, DSH_FORK_PACKAGES,
# DSH_MARKET_VERSION, PNPM_VERSION) live in the Dockerfile. Set one here only
# to override it for a build; DSH_VERSION must be the release the fork commit
# extends.
