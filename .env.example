# Required for model requests. The key can also be entered in Settings > Models.
DEEPSEEK_API_KEY=

# Pin the npm package versions used by the image build.
# DSH_VERSION must be the release the fork commit extends.
DSH_VERSION=0.2.1-rc.1
DSH_FORK_REPOSITORY=https://github.com/eamars/deepseek-harness.git
DSH_FORK_COMMIT=d67d7cf4fd17d2810efd7b514fec9e765326da75
DSH_MARKET_VERSION=1.66.22
PNPM_VERSION=12.4.2
